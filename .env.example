# ==============================================================================
# ZERO_WEB: Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY NOTICE FOR BEGINNERS:
# 1. NEVER commit your real .env file or real secrets to GitHub!
# 2. Duplicate this file as ".env" (or ".env.local") on your computer.
# 3. Replace the placeholder values below with your actual credentials.
# 4. Your real .env file is safely ignored by Git via .gitignore.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Frontend Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend & Database (Used in Phase 3 & 4)
# Get your connection string from MongoDB Atlas Cloud Console
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=zero_web_dev

# Authentication & Security (Used in Phase 5)
# Generate a random string using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_32_char_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Transactional Email & OTP Verification (Used in Phase 5)
# Get your API key from Brevo (formerly Sendinblue)
BREVO_API_KEY=xkeysib-placeholder-replace-with-your-brevo-key
BREVO_SENDER_EMAIL=verify@yourwebsite.com
BREVO_SENDER_NAME=ZeroWeb Authentication

# Artificial Intelligence (Used in Phase 5)
# Get your API key from Google AI Studio (ai.google.dev)
GEMINI_API_KEY=placeholder_gemini_api_key_from_google_ai_studio

# Allowed CORS Origins (Frontend URL for Backend Server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

